@article{szabo_changing_2021,
	title = {The changing face of {AU} {Mic} b: stellar spots, spin-orbit commensurability, and transit timing variations as seen by {CHEOPS} and {TESS}},
	volume = {654},
	issn = {0004-6361, 1432-0746},
