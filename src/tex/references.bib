@article{knudstrup_extremely_2020,
	title = {Extremely precise age and metallicity of the open cluster {NGC} 2506 using detached eclipsing binaries},
	issn = {0035-8711, 1365-2966},
	url = {http://arxiv.org/abs/2009.08788},
	doi = {10.1093/mnras/staa2855},
	abstract = {Accurate stellar parameters of stars in open clusters can help constrain models of stellar structure and evolution. Here we wish to determine the age and metallicity content of the open cluster NGC 2506. To this end we investigated three detached eclipsing binaries (DEBs; V2032, V4, and V5) for which we determined their masses and radii, as well as four red giant branch stars for which we determined their effective temperatures, surface gravities, and metallicities. Three of the stars in the DEBs have masses close to the cluster turn-off mass, allowing for extremely precise age determination. Comparing the values for the masses and radii of the binaries to BaSTI isochrones we estimated a cluster age of {\textbackslash}2.01 {\textbackslash}textbackslashpm 0.10{\textbackslash} Gyr. This does depend on the models used in the comparison, where we have found that the inclusion of convective core-overshooting is necessary to properly model the cluster. From red giant branch stars we determined values for the effective temperatures, the surface gravities, and the metallicities. From these we find a cluster metallicity of {\textbackslash}-0.36 {\textbackslash}textbackslashpm 0.10{\textbackslash} dex. Using this value and the values for the effective temperatures we determine the reddening to be E{\textbackslash}(b - y) = 0.057 {\textbackslash}textbackslashpm 0.004{\textbackslash} mag. Furthermore, we derived the distance to the cluster from Gaia parallaxes and found {\textbackslash}3.101 {\textbackslash}textbackslashpm 0.017{\textbackslash} kpc, and we have performed a radial velocity membership determination for stars in the field of the cluster. Finally, we report on the detection of oscillation signals in \{\vphantom{\}}{\textbackslash}textbackslashgamma{\textbackslash} Dor and \{\vphantom{\}}{\textbackslash}textbackslashdelta{\textbackslash} Scuti members in data from the TESS mission, including the possible detection of solar-like oscillations in two of the red giants.},
	urldate = {2020-09-30},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Knudstrup, E. and Grundahl, F. and Brogaard, K. and Slumstrup, D. and Orosz, J. A. and Sandquist, E. L. and Jessen-Hansen, J. and Lund, M. N. and Arentoft, T. and Tronsgaard, R. and Yong, D. and Frandsen, S. and Bruntt, H.},
	month = sep,
	year = {2020},
	keywords = {Astrophysics - Solar and Stellar Astrophysics, Astrophysics - Astrophysics of Galaxies},
	pages = {staa2855},
	annote = {arXiv: 2009.08788},
}

