	volume = {151},
	issn = {1538-3881},
	url = {http://arxiv.org/abs/1602.01901},
	doi = {10.3847/0004-6256/151/5/112},
	abstract = {We present the discovery in Kepler's {\textbackslash}K2{\textbackslash} mission observations and our follow-up radial velocity observations from Keck/HIRES for four eclipsing binary (EB) star systems in the young benchmark Pleiades cluster. Based on our modeling results, we announce two new low mass ({\textbackslash}M\_\{tot\} {\textbackslash}textless 0.6 M\_{\textbackslash}textbackslashodot{\textbackslash}) EBs among Pleiades members (HCG 76 and MHO 9) and we report on two previously known Pleiades binaries that are also found to be EB systems (HII 2407 and HD 23642). We measured the masses of the binary HCG 76 to \{\vphantom{\}}{\textbackslash}textbackslashlesssim{\textbackslash}2.5\% precision, and the radii to \{\vphantom{\}}{\textbackslash}textbackslashlesssim{\textbackslash}4.5\% precision, which together with the precise effective temperatures yield an independent Pleiades distance of 132\{\vphantom{\}}{\textbackslash}textbackslashpm{\textbackslash}5 pc. We discuss another EB towards the Pleiades that is a possible but unlikely Pleiades cluster member (AK II 465). The two new confirmed Pleiades systems extend the mass range of Pleiades EB components to 0.2-2 {\textbackslash}M\_{\textbackslash}textbackslashodot{\textbackslash}. Our initial measurements of the fundamental stellar parameters for the Pleiades EBs are discussed in the context of the current stellar models and the nominal cluster isochrone, finding good agreement with the stellar models of Baraffe et al. (2015) at the nominal Pleiades age of 120 Myr. Finally, in the Hyades, we report a new low mass eclipsing system (vA 50) that was concurrently discovered and studied by Mann et al. (2016). We confirm that the eclipse is likely caused by a Neptune-sized transiting planet, and with the additional radial velocity constraints presented here we improve the constraint on the maximum mass of the planet to be \{\vphantom{\}}{\textbackslash}textbackslashlesssim{\textbackslash}1.2 {\textbackslash}M\_{\textbackslash}textbackslashmathrm\{Jup\}{\textbackslash}.},
	number = {5},
	urldate = {2020-09-11},
	journal = {The Astronomical Journal},
	author = {David, Trevor J. and Conroy, Kyle E. and Hillenbrand, Lynne A. and Stassun, Keivan G. and Stauffer, John and Rebull, Luisa M. and Cody, Ann Marie and Isaacson, Howard and Howard, Andrew W. and Aigrain, Suzanne},
	month = apr,
	year = {2016},
	keywords = {Astrophysics - Solar and Stellar Astrophysics},
	pages = {112},
	annote = {arXiv: 1602.01901},
}

@article{david_k2_2015,
	title = {K2 {Discovery} of {Young} {Eclipsing} {Binaries} in {Upper} {Scorpius}: {Direct} {Mass} and {Radius} {Determinations} for the {Lowest} {Mass} {Stars} and {Initial} {Characterization} of an {Eclipsing} {Brown} {Dwarf} {Binary}},
	volume = {816},
	issn = {1538-4357},
	shorttitle = {K2 {Discovery} of {Young} {Eclipsing} {Binaries} in {Upper} {Scorpius}},
	url = {http://arxiv.org/abs/1510.08087},
	doi = {10.3847/0004-637X/816/1/21},
	abstract = {We report the discovery of three low-mass double-lined eclipsing binaries in the pre-main sequence Upper Scorpius association, revealed by {\textbackslash}K2{\textbackslash} photometric monitoring of the region over \{\vphantom{\}}{\textbackslash}textbackslashsim{\textbackslash} 78 days. The orbital periods of all three systems are \{\vphantom{\}}{\textbackslash}textless{\textbackslash}5 days. We use the {\textbackslash}K2{\textbackslash} photometry plus multiple Keck/HIRES radial velocities and spectroscopic flux ratios to determine fundamental stellar parameters for both the primary and secondary components of each system, along with the orbital parameters. We present tentative evidence that EPIC 203868608 is a hierarchical triple system comprised of an eclipsing pair of \{\vphantom{\}}{\textbackslash}textbackslashsim{\textbackslash}25 {\textbackslash}M\_{\textbackslash}textbackslashmathrm\{Jup\}{\textbackslash} brown dwarfs with a wide M-type companion. If confirmed, it would constitute only the second double-lined eclipsing brown dwarf binary system discovered to date. The double-lined system EPIC 203710387 is composed of nearly identical M4.5-M5 stars with fundamentally determined masses and radii measured to better than 3\% precision ({\textbackslash}M\_1=0.1183{\textbackslash}textbackslashpm0.0028 M\_{\textbackslash}textbackslashodot{\textbackslash}, {\textbackslash}M\_2=0.1076{\textbackslash}textbackslashpm0.0031 M\_{\textbackslash}textbackslashodot{\textbackslash} and {\textbackslash}R\_1=0.417{\textbackslash}textbackslashpm0.010 R\_{\textbackslash}textbackslashodot{\textbackslash}, {\textbackslash}R\_2=0.450{\textbackslash}textbackslashpm0.012 R\_{\textbackslash}textbackslashodot{\textbackslash}) from combination of the light curve and radial velocity time series. These stars have the lowest masses of any stellar mass double-lined eclipsing binary to date. Finally, EPIC 203476597 is a compact single-lined system with a G8-KO primary and a likely mid-K secondary whose line are revealed in spectral ratios. Continued measurement of radial velocities and spectroscopic flux ratios will better constrain fundamental parameters and should elevate the objects to benchmark status. We also present revised parameters for the double-lined eclipsing binary UScoCTIO 5 ({\textbackslash}M\_1=0.3336{\textbackslash}textbackslashpm0.0022 M\_{\textbackslash}textbackslashodot{\textbackslash}, {\textbackslash}M\_2=0.3200{\textbackslash}textbackslashpm0.0022 M\_{\textbackslash}textbackslashodot{\textbackslash} and {\textbackslash}R\_1=0.862{\textbackslash}textbackslashpm0.012{\textbackslash}, {\textbackslash}R\_2=0.852{\textbackslash}textbackslashpm0.013 R\_{\textbackslash}textbackslashodot{\textbackslash}). We discuss the implications of our results on these \{\vphantom{\}}{\textbackslash}textbackslashsim{\textbackslash}0.1-1.5 {\textbackslash}M\_{\textbackslash}textbackslashodot{\textbackslash} stars for pre-main-sequence evolutionary models.},
	number = {1},
	urldate = {2020-09-10},
	journal = {The Astrophysical Journal},
	author = {David, Trevor J. and Hillenbrand, Lynne A. and Cody, Ann Marie and Carpenter, John M. and Howard, Andrew W.},
	month = dec,
	year = {2015},
	keywords = {Astrophysics - Solar and Stellar Astrophysics},
	pages = {21},
	annote = {arXiv: 1510.08087},
}

@article{matson_radial_2017,
	title = {Radial {Velocities} of 41 \textit{{Kepler}} {Eclipsing} {Binaries}},
	volume = {154},
	issn = {1538-3881},
	url = {https://iopscience.iop.org/article/10.3847/1538-3881/aa8fd6},
	doi = {10.3847/1538-3881/aa8fd6},
	abstract = {Eclipsing binaries are vital for directly determining stellar parameters without reliance on models or scaling relations. Spectroscopically derived parameters of detached and semi-detached binaries allow us to determine component masses that can inform theories of stellar and binary evolution. Here we present moderate resolution ground-based spectra of stars in close binary systems with and without (detected) tertiary companions observed by NASA’s Kepler mission and analyzed for eclipse timing variations. We obtain radial velocities and spectroscopic orbits for ﬁve single-lined and 35 double-lined systems, and conﬁrm one false positive eclipsing binary. For the double-lined spectroscopic binaries, we also determine individual component masses and examine the mass ratio M2 M1 distribution, which is dominated by binaries with like-mass pairs and semi-detached classical Algol systems that have undergone mass transfer. Finally, we constrain the mass of the tertiary component for ﬁve double-lined binaries with previously detected companions.},
	language = {en},
	number = {6},
	urldate = {2020-09-10},
	journal = {The Astronomical Journal},
	author = {Matson, Rachel A. and Gies, Douglas R. and Guo, Zhao and Williams, Stephen J.},
	month = nov,
	year = {2017},
	pages = {216},
}

@article{volk_curiously_2017,
	title = {The curiously warped mean plane of the {Kuiper} belt},
	volume = {154},
	issn = {1538-3881},
	url = {http://arxiv.org/abs/1704.02444},
	doi = {10.3847/1538-3881/aa79ff},
	abstract = {We measured the mean plane of the Kuiper belt as a function of semi-major axis. For the classical Kuiper belt as a whole (the non-resonant objects in the semi-major axis range 42–48{\textbackslash}textasciitildeau), we find a mean plane of inclination {\textbackslash}i\_m=1.8ˆ\{{\textbackslash}textbackslashcirc\}{\textbackslash}ˆ\{+0.7ˆ\{{\textbackslash}textbackslashcirc\}\}\_\{-0.4ˆ\{{\textbackslash}textbackslashcirc\}\}{\textbackslash} and longitude of ascending node \{\vphantom{\}}{\textbackslash}textbackslashOmega\_m=77ˆ\{{\textbackslash}textbackslashcirc\}{\textbackslash}ˆ\{+18ˆ\{{\textbackslash}textbackslashcirc\}\}\_\{-14ˆ\{{\textbackslash}textbackslashcirc\}\}{\textbackslash} (in the J2000 ecliptic-equinox coordinate system), in accord with theoretical expectations of the secular effects of the known planets. With finer semi-major axis bins, we detect a statistically significant warp in the mean plane near semi-major axes 40–42{\textbackslash}textasciitildeau. Linear secular theory predicts a warp near this location due to the \{\vphantom{\}}{\textbackslash}textbackslashnu\_\{18\}{\textbackslash} nodal secular resonance, however the measured mean plane for the 40.3-42{\textbackslash}textasciitildeau semi-major axis bin (just outside the \{\vphantom{\}}{\textbackslash}textbackslashnu\_\{18\}{\textbackslash}) is inclined \{\vphantom{\}}{\textbackslash}textbackslashsim13ˆ\{{\textbackslash}textbackslashcirc\}{\textbackslash} to the predicted plane, a nearly 3-\{\vphantom{\}}{\textbackslash}textbackslashsigma{\textbackslash} discrepancy. For the more distant Kuiper belt objects of semi-major axes in the range 50–80{\textbackslash}textasciitildeau, the expected mean plane is close to the invariable plane of the solar system, but the measured mean plane deviates greatly from this: it has inclination {\textbackslash}i\_m=9.1ˆ\{{\textbackslash}textbackslashcirc\}{\textbackslash}ˆ\{+6.6ˆ\{{\textbackslash}textbackslashcirc\}\}\_\{-3.8ˆ\{{\textbackslash}textbackslashcirc\}\}{\textbackslash} and longitude of ascending node \{\vphantom{\}}{\textbackslash}textbackslashOmega\_m=227ˆ\{{\textbackslash}textbackslashcirc\}{\textbackslash}ˆ\{+18ˆ\{{\textbackslash}textbackslashcirc\}\}\_\{-44ˆ\{{\textbackslash}textbackslashcirc\}\}{\textbackslash}. We estimate this deviation from the expected mean plane to be statistically significant at the \{\vphantom{\}}{\textbackslash}textbackslashsim97-99{\textbackslash}textbackslash\%{\textbackslash} confidence level. We discuss several possible explanations for this deviation, including the possibility that a relatively close-in ({\textbackslash}a{\textbackslash}textbackslashlesssim100\{\vphantom{\}}{\textbackslash}textasciitildeau), unseen small planetary-mass object in the outer solar system is responsible for the warping.},
	number = {2},
	urldate = {2020-08-28},
	journal = {The Astronomical Journal},
	author = {Volk, Kathryn and Malhotra, Renu},
	month = jul,
	year = {2017},
	keywords = {Astrophysics - Earth and Planetary Astrophysics},
	pages = {62},
	annote = {arXiv: 1704.02444},
}

