
@article{rainer_gaps_2023,
	title = {The {GAPS} programme at {TNG} - {XLIV}. {Projected} rotational velocities of 273 exoplanet-host stars observed with {HARPS}-{N}},
	volume = {676},
	copyright = {© The Authors 2023},
	issn = {0004-6361, 1432-0746},
	url = {https://www.aanda.org/articles/aa/abs/2023/08/aa45564-22/aa45564-22.html},
	doi = {10.1051/0004-6361/202245564},
	abstract = {{\textless}i{\textgreater}Context.{\textless}i/{\textgreater} The leading spectrographs used for exoplanets’ search and characterization offer online data reduction softwares (DRS) that yield, as an ancillary result, the full-width at half-maximum (FWHM) of the cross-correlation function (CCF) that is used to estimate the radial velocity of the host star. The FWHM also contains information on the stellar projected rotational velocity {\textless}i{\textgreater}v{\textless}i/{\textgreater}{\textless}sub{\textgreater}eq{\textless}sub/{\textgreater} sin {\textless}i{\textgreater}i{\textless}i/{\textgreater}{\textless}sub{\textgreater}★{\textless}sub/{\textgreater}, if appropriately calibrated.{\textless}i{\textgreater}Aims.{\textless}i/{\textgreater} We wanted to establish a simple relationship to derive the {\textless}i{\textgreater}v{\textless}i/{\textgreater}{\textless}sub{\textgreater}eq{\textless}sub/{\textgreater} sin {\textless}i{\textgreater}i{\textless}i/{\textgreater}{\textless}sub{\textgreater}★{\textless}sub/{\textgreater} directly from the FWHM computed by the HARPS-N DRS in the case of slow-rotating solar-like stars. This may also help to recover the stellar inclination {\textless}i{\textgreater}i{\textless}i/{\textgreater}{\textless}sub{\textgreater}★{\textless}sub/{\textgreater}, which in turn affects the exoplanets’ parameters.{\textless}i{\textgreater}Methods.{\textless}i/{\textgreater} We selected stars with an inclination of the spin axis compatible with 90 deg by looking at exoplanetary transiting systems with known small sky-projected obliquity: for these calibrators, we can presume that {\textless}i{\textgreater}v{\textless}i/{\textgreater}{\textless}sub{\textgreater}eq{\textless}sub/{\textgreater} sin {\textless}i{\textgreater}i{\textless}i/{\textgreater}{\textless}sub{\textgreater}★{\textless}sub/{\textgreater} is equal to stellar equatorial velocity {\textless}i{\textgreater}v{\textless}i/{\textgreater}{\textless}sub{\textgreater}eq{\textless}sub/{\textgreater}. We derived their rotational periods from photometric and spectroscopic time series and their radii from the spectral energy distribution (SED) fitting. This allowed us to recover their {\textless}i{\textgreater}v{\textless}i/{\textgreater}{\textless}sub{\textgreater}eq{\textless}sub/{\textgreater}, which could be compared to the FWHM values of the CCFs obtained both with G2 and K5 spectral-type masks.{\textless}i{\textgreater}Results.{\textless}i/{\textgreater} We obtained an empirical relation for each mask: this can be used to derive {\textless}i{\textgreater}v{\textless}i/{\textgreater}{\textless}sub{\textgreater}eq{\textless}sub/{\textgreater} sin {\textless}i{\textgreater}i{\textless}i/{\textgreater}{\textless}sub{\textgreater}★{\textless}sub/{\textgreater} directly from FWHM values for slow rotators ({\textless}i{\textgreater}FWHM{\textless}i/{\textgreater} {\textless} 20 km s{\textless}sup{\textgreater}−1{\textless}sup/{\textgreater}). We applied our relations to 273 exoplanet-host stars observed with HARPS-N, obtaining homogeneous {\textless}i{\textgreater}v{\textless}i/{\textgreater}{\textless}sub{\textgreater}eq{\textless}sub/{\textgreater}sin {\textless}i{\textgreater}i{\textless}i/{\textgreater}{\textless}sub{\textgreater}★{\textless}sub/{\textgreater} measurements. When possible, we compared our results with the literature ones to confirm the reliability of our work. We were also able to recover or constrain {\textless}i{\textgreater}i{\textless}i/{\textgreater}{\textless}sub{\textgreater}★{\textless}sub/{\textgreater} for 12 objects with no prior {\textless}i{\textgreater}v{\textless}i/{\textgreater}{\textless}sub{\textgreater}eq{\textless}sub/{\textgreater} sin {\textless}i{\textgreater}i{\textless}i/{\textgreater}{\textless}sub{\textgreater}★{\textless}sub/{\textgreater} estimation.{\textless}i{\textgreater}Conclusions.{\textless}i/{\textgreater} We provide two simple empirical relations to directly convert the HARPS-N FWHM obtained with the G2 and K5 mask to a {\textless}i{\textgreater}v{\textless}i/{\textgreater}{\textless}sub{\textgreater}eq{\textless}sub/{\textgreater} sin {\textless}i{\textgreater}i{\textless}i/{\textgreater}{\textless}sub{\textgreater}★{\textless}sub/{\textgreater} value. We tested our results on a statistically significant sample, and we found a good agreement with literature values found with more sophisticated methods for stars with log {\textless}i{\textgreater}ɡ{\textless}i/{\textgreater} {\textgreater} 3.5. We also tried our relation on HARPS and SOPHIE data, and we conclude that it can be used as it is also on FWHM derived by HARPS DRS with the G2 and K5 mask, and it may be adapted to the SOPHIE data as long as the spectra are taken in high-resolution mode.},
	language = {en},
	urldate = {2026-03-25},
	journal = {A\&A},
	publisher = {EDP Sciences},
	author = {Rainer, M. and Desidera, S. and Borsa, F. and Barbato, D. and Biazzo, K. and Bonomo, A. and Gratton, R. and Messina, S. and Scandariato, G. and Affer, L. and Benatti, S. and Carleo, I. and Cabona, L. and Covino, E. and Lanza, A. F. and Ligi, R. and Maldonado, J. and Mancini, L. and Nardiello, D. and Sicilia, D. and Sozzetti, A. and Bignamini, A. and Cosentino, R. and Knapic, C. and Fiorenzano, A. F. Martínez and Molinari, E. and Pedani, M. and Poretti, E.},
	month = aug,
	year = {2023},
	keywords = {\#broken},
	pages = {A90},
}

@article{claret2025,
  title         = {Limb-{{Darkening Coefficients}} for the 4-{{Term}} and {{Power-2 Laws}} for the {{JWST Space Mission}}, {{Adopting PHOENIX Spherical Models}} at {{High Resolution}}},
  author        = {Claret, A. and Hauschildt, P. H. and Torres, G.},
  year          = 2025,
  month         = jul,
  journal       = {Astronomy \& Astrophysics},
  volume        = {699},
  eprint        = {2506.07265},
  primaryclass  = {astro-ph.SR},
  pages         = {A97},
  issn          = {0004-6361, 1432-0746},
  doi           = {10.1051/0004-6361/202554770},
  urldate       = {2026-09-08},
  abstract      = {Modeling observations of transiting exoplanets or close binary systems by comparing the observations with theoretical light curves requires precise knowledge of the distribution of specific intensities across the stellar disk. We aim to facilitate this type of research by providing extensive tabulations of limb-darkening coefficients for 11 frequently used near- and mid-infrared passbands on the NIRCam, NIRISS, and NIRSpec instruments installed on board the James Webb Space Telescope. The calculation of the limb-darkening coefficients was based on spherically symmetric atmosphere models from the PHOENIX series, with high spectral resolution (approximately \$10\textasciicircum\textbraceleft 6\textbraceright\$ wavelengths), and covering the wavelength range \$0.1-6.0\textasciitilde{$\mu\$$}m. The models were computed for solar composition, and a microturbulent velocity of 1.0 km s\$\textasciicircum\textbraceleft -1\textbraceright\$. We adopted two of the more accurate parametrizations for the coefficients: the 4-term law, and the power-2 law. We applied the Levenberg-Marquardt least-squares minimization method, with a strategy to determine the critical value \${$\mu\_$}\textbraceleft\textbackslash rm crit\textbraceright\$ of the cosine of the viewing angle near the limb that is designed to improve numerical accuracy. The limb-darkening coefficients were derived based on a total of 306 atmosphere models covering an effective temperature range of \$2400-7800\$ K, and a \$\textbackslash log g\$ interval between 3.0 and 5.5. We discuss the quality of the fits to the specific intensities provided by the power-2 and 4-term laws, as well as by the often used quadratic law. Based on a comparison, we recommend the use of the 4-term or power-2 laws, in that order of preference.},
  archiveprefix = {arXiv},
  keywords      = {Astrophysics - Earth and Planetary Astrophysics,Astrophysics - Solar and Stellar Astrophysics},
}

