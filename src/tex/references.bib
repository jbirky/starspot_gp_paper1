	url = {https://www.aanda.org/10.1051/0004-6361/202140345},
	doi = {10.1051/0004-6361/202140345},
	abstract = {AU Mic is a young planetary system with a resolved debris disc showing signs of planet formation and two transiting warm Neptunes near mean-motion resonances. Here we analyse three transits of AU Mic b observed with the CHaracterising ExOPlanet Satellite (CHEOPS), supplemented with sector 1 and 27 Transiting Exoplanet Survey Satellite (TESS) photometry, and the All-Sky Automated Survey from the ground. The reﬁned orbital period of AU Mic b is 8.462995 ± 0.000003 d, whereas the stellar rotational period is Prot = 4.8367 ± 0.0006 d. The two periods indicate a 7:4 spin–orbit commensurability at a precision of 0.1\%. Therefore, all transits are observed in front of one of the four possible stellar central longitudes. This is strongly supported by the observation that the same complex star-spot pattern is seen in the second and third CHEOPS visits that were separated by four orbits (and seven stellar rotations). Using a bootstrap analysis we ﬁnd that ﬂares and star spots reduce the accuracy of transit parameters by up to 10\% in the planet-to-star radius ratio and the accuracy on transit time by 3–4 min. Nevertheless, occulted stellar spot features independently conﬁrm the presence of transit timing variations (TTVs) with an amplitude of at least 4 min. We ﬁnd that the outer companion, AU Mic c, may cause the observed TTVs.},
	language = {en},
	urldate = {2022-03-01},
	journal = {Astronomy \& Astrophysics},
	author = {Szabó, Gy. M. and Gandolfi, D. and Brandeker, A. and Csizmadia, Sz. and Garai, Z. and Billot, N. and Broeg, C. and Ehrenreich, D. and Fortier, A. and Fossati, L. and Hoyer, S. and Kiss, L. and des Etangs, A. Lecavelier and Maxted, P. F. L. and Ribas, I. and Alibert, Y. and Alonso, R. and Anglada Escudé, G. and Bárczy, T. and Barros, S. C. C. and Barrado, D. and Baumjohann, W. and Beck, M. and Beck, T. and Bekkelien, A. and Bonfils, X. and Benz, W. and Borsato, L. and Busch, M-D. and Cabrera, J. and Charnoz, S. and Collier Cameron, A. and Van Damme, C. Corral and Davies, M. B. and Delrez, L. and Deleuil, M. and Demangeon, O. D. S. and Demory, B.-O. and Erikson, A. and Fridlund, M. and Futyan, D. and García Muñoz, A. and Gillon, M. and Guedel, M. and Guterman, P. and Heng, K. and Isaak, K. G. and Lacedelli, G. and Laskar, J. and Lendl, M. and Lovis, C. and Luntzer, A. and Magrin, D. and Nascimbeni, V. and Olofsson, G. and Osborn, H. P. and Ottensamer, R. and Pagano, I. and Pallé, E. and Peter, G. and Piazza, D. and Piotto, G. and Pollacco, D. and Queloz, D. and Ragazzoni, R. and Rando, N. and Rauer, H. and Santos, N. C. and Scandariato, G. and Ségransan, D. and Serrano, L. M. and Sicilia, D. and Simon, A. E. and Smith, A. M. S. and Sousa, S. G. and Steller, M. and Thomas, N. and Udry, S. and Van Grootel, V. and Walton, N. A. and Wilson, T. G.},
	month = oct,
	year = {2021},
	pages = {A159},
}

@article{szabo_mapping_2014,
	title = {Mapping a star with transits: orbit precession effects in the {Kepler}-13 system},
	volume = {437},
	issn = {1365-2966, 0035-8711},
	shorttitle = {Mapping a star with transits},
	url = {http://academic.oup.com/mnras/article/437/2/1045/1088095/Mapping-a-star-with-transits-orbit-precession},
	doi = {10.1093/mnras/stt1724},
	abstract = {Kepler-13b is a most intriguing exoplanet system due to the rapid precession rate, exhibiting several exotic phenomena. We analysed Kepler short cadence data up to Quarter 14, with a total time-span of 928 d, to reveal changes in transit duration, depth, asymmetry and identify the possible signals of stellar rotation and low-level activity. We investigated long-term variations of transit light curves testing for duration, peak depth and asymmetry. We also performed cluster analysis on Kepler quarters. We computed the autocorrelation function of the out-oftransit light variations. Transit duration, peak depth and asymmetry evolve slowly, due to the slowly drifting transit path through the stellar disc. The detected transit shapes will map the stellar surface on the time-scale of decades. We found a very signiﬁcant clustering pattern with 3-orbit period. Its source is very probably the rotating stellar surface, in the 5:3 spin–orbit resonance reported in a previous study. The autocorrelation function of the out-of-transit light variations, ﬁltered to 25.4 h and harmonics, shows slow variations and a peak around 300–360 d period, which could be related to the activity cycle of the host star.},
	language = {en},
	number = {2},
	urldate = {2022-03-01},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Szabó, Gy. M. and Simon, A. and Kiss, L. L.},
	month = jan,
	year = {2014},
	pages = {1045--1050},
}

