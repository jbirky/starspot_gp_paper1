@article{hwang_wide_2022,
	title = {Wide twin binaries are extremely eccentric: evidence of twin binary formation in circumbinary disks},
	volume = {933},
	issn = {2041-8205, 2041-8213},
	shorttitle = {Wide twin binaries are extremely eccentric},
	url = {http://arxiv.org/abs/2205.05690},
	doi = {10.3847/2041-8213/ac7c70},
	abstract = {The Gaia mission recently revealed an excess population of equal-mass "twin" wide binaries, with mass ratio {\textbackslash}q{\textbackslash}textbackslashgtrsim 0.95{\textbackslash}, extending to separations of at least 1000 AU. The origin of this population is an enigma: twin binaries are thought to form via correlated accretion in circumbinary disks, but the typical observed protostellar disks have radii of \{\vphantom{\}}{\textbackslash}textbackslashsim100{\textbackslash} AU, far smaller than the separations of the widest twins. Here, we infer the eccentricity distribution of wide twins from the distribution of their {\textbackslash}v{\textbackslash}-{\textbackslash}r{\textbackslash} angles, i.e., the angle between the components' separation and relative velocity vectors. We find that wide twins must be on extremely eccentric orbits. For the excess-twin population at 400-1000 AU, we infer a near-delta function excess of high-eccentricity system, with eccentricity {\textbackslash}0.95 {\textbackslash}textbackslashlesssim e {\textbackslash}textbackslashleq 1{\textbackslash}. These high eccentricities for wide twins imply pericenter distances of order {\textbackslash}10{\textbackslash} AU and suggest that their orbits were scattered via dynamical interactions in their birth environments, consistent with a scenario in which twins are born in circumbinary disks and subsequently widened. These results further establish twin wide binaries as a distinct population and imply that wide twins can be used as a probe of the dynamical history of stellar populations.},
	number = {2},
	urldate = {2023-01-01},
	journal = {The Astrophysical Journal Letters},
	author = {Hwang, Hsiang-Chih and El-Badry, Kareem and Rix, Hans-Walter and Hamilton, Chris and Ting, Yuan-Sen and Zakamska, Nadia},
	month = jul,
	year = {2022},
	keywords = {Astrophysics - Solar and Stellar Astrophysics, Astrophysics - Earth and Planetary Astrophysics, Astrophysics - Astrophysics of Galaxies},
	pages = {L32},
	annote = {arXiv:2205.05690 [astro-ph]},
}

@misc{mooij_ordinary_2014,
	title = {From {Ordinary} {Differential} {Equations} to {Structural} {Causal} {Models}: the deterministic case},
	shorttitle = {From {Ordinary} {Differential} {Equations} to {Structural} {Causal} {Models}},
