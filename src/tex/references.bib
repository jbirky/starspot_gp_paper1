@article{mardling_new_2013,
	title = {New developments for modern celestial mechanics – {I}. {General} coplanar three-body systems. {Application} to exoplanets},
	volume = {435},
	issn = {1365-2966, 0035-8711},
	url = {http://academic.oup.com/mnras/article/435/3/2187/1024281/New-developments-for-modern-celestial-mechanics-I},
