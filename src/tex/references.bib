@article{rose_companion-driven_2019,
	title = {Companion-driven evolution of massive stellar binaries},
	volume = {488},
	issn = {0035-8711, 1365-2966},
	url = {http://arxiv.org/abs/1903.12185},
	doi = {10.1093/mnras/stz1846},
	abstract = {At least {\textbackslash}70{\textbackslash}textbackslash\%{\textbackslash} of massive OBA-type stars reside in binary or higher-order systems. The dynamical evolution of these systems can lend insight into the origins of extreme phenomena such as X-ray binaries and gravitational wave sources. In one such dynamical process, the Eccentric Kozai-Lidov (EKL) Mechanism, a third companion star alters the secular evolution of a binary system. For dynamical stability, these triple systems must have a hierarchical configuration. We explore the effects of a distant third companion's gravitational perturbations on a massive binary's orbital configuration before significant stellar evolution has taken place (\{\vphantom{\}}{\textbackslash}textbackslashleq 10{\textbackslash} Myr). We include tidal dissipation and general relativistic precession. With large ({\textbackslash}38,000{\textbackslash} total) Monte-Carlo realizations of massive hierarchical triples, we characterize imprints of the birth conditions on the final orbital distributions. Specifically, we find that the final eccentricity distribution over the range {\textbackslash}0.1-0.7{\textbackslash} is an excellent indicator of its birth distribution. Furthermore, we find that the period distributions have a similar mapping for wide orbits. Finally, we demonstrate that the observed period distribution for approximately {\textbackslash}10{\textbackslash} Myr-old massive stars is consistent with EKL evolution.},
	number = {2},
	urldate = {2020-09-15},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Rose, Sanaea C. and Naoz, Smadar and Geller, Aaron M.},
	month = sep,
	year = {2019},
	keywords = {Astrophysics - Solar and Stellar Astrophysics, Astrophysics - High Energy Astrophysical Phenomena},
	pages = {2480--2492},
	annote = {arXiv: 1903.12185},
}

@article{koppelman_frequencies_2020,
	title = {Frequencies, chaos and resonances: a study of orbital parameters of nearby thick disc and halo stars},
	shorttitle = {Frequencies, chaos and resonances},
	url = {http://arxiv.org/abs/2009.04849},
	abstract = {We study the distribution of nearby thick disc and halo stars in subspaces defined by their characteristic orbital parameters. Our aim is to establish the origin of the structure reported in particular, in the {\textbackslash}R\_\{{\textbackslash}textbackslashrm max\}-z\_\{{\textbackslash}textbackslashrm max\}{\textbackslash} space. To this end, we compute the orbital parameters and frequencies of stars for a generic and for a St{\textbackslash}textbackslash"ackel Milky Way potential. We find that for both the thick disc and halo populations very similar prominent substructures are apparent for the generic Galactic potential, while no substructure is seen for the St{\textbackslash}textbackslash"ackel model. This indicates that the origin of these features is not merger-related, but due to non-integrability of the generic potential. This conclusion is strengthened by our frequency analysis of the orbits of stars, which reveals the presence of prominent resonances, with \{\vphantom{\}}{\textbackslash}textbackslashsim 30{\textbackslash}textbackslash\%{\textbackslash} of the halo stars associated to resonance families. In fact, the stars in resonances define the substructures seen in the spaces of characteristic orbital parameters. Furthermore, we find that some stars in our sample and in debris streams are on the same resonance as the Sagittarius dwarf, suggesting this system has also influenced the distribution of stars in the Galactic thick disc and halo components. Our study constitutes a step towards disentangling the imprint of merger debris from substructures driven by internal dynamics. Given their prominence, these resonant-driven overdensities could potentially be useful to constrain the exact form of the Galactic potential.},
	urldate = {2020-09-15},
	journal = {arXiv:2009.04849 [astro-ph]},
	author = {Koppelman, Helmer H. and Hagen, Jorrit H. J. and Helmi, Amina},
	month = sep,
	year = {2020},
	keywords = {Astrophysics - Astrophysics of Galaxies},
	annote = {arXiv: 2009.04849},
}

@article{soydugan_kepler_2020,
	title = {Kepler {Binary} {Stars} in {NGC} 6819 {Open} {Cluster}: {KIC} 5113146 and {KIC} 5111815},
	shorttitle = {Kepler {Binary} {Stars} in {NGC} 6819 {Open} {Cluster}},
	url = {http://arxiv.org/abs/2009.05610},
	abstract = {In this study, investigation of two double-lined binary stars KIC 5113146 and KIC 5111815 in NGC 6819 is presented based on both photometric and spectroscopic data. Simultaneous analysis of light and radial velocity curves was made and the absolute parameters of the systems' components were determined for the first time. We find that both systems have F-type main-sequence components. The masses and radii were found to be {\textbackslash}M\_1=1.29{\textbackslash}textbackslashpm0.02 M\_\{{\textbackslash}textbackslashodot\}{\textbackslash}, {\textbackslash}R\_\{1\}=1.47{\textbackslash}textbackslashpm0.03 R\_\{{\textbackslash}textbackslashodot\}{\textbackslash} and {\textbackslash}M\_\{2\}=1.19{\textbackslash}textbackslashpm0.02 M\_\{{\textbackslash}textbackslashodot\}{\textbackslash}, {\textbackslash}R\_\{2\}=1.13{\textbackslash}textbackslashpm0.02 R\_\{{\textbackslash}textbackslashodot\}{\textbackslash} for the primary and secondary components of KIC 5113146; {\textbackslash}M\_\{1\}=1.51{\textbackslash}textbackslashpm0.08 M\_\{{\textbackslash}textbackslashodot\}{\textbackslash}, {\textbackslash}R\_\{1\}=2.02{\textbackslash}textbackslashpm0.05 R\_\{{\textbackslash}textbackslashodot\}{\textbackslash} and {\textbackslash}M\_\{2\}=1.19{\textbackslash}textbackslashpm0.07 M\_\{{\textbackslash}textbackslashodot\}{\textbackslash}, {\textbackslash}R\_\{2\}=1.32{\textbackslash}textbackslashpm0.04 R\_\{{\textbackslash}textbackslashodot\}{\textbackslash} for components of KIC 5111815, respectively. Evolutionary status of the components was evaluated based on the MESA evolutionary tracks and isochrones. The ages of the KIC 5111815 and KIC 5113146 were derived to be about {\textbackslash}2.50{\textbackslash}textbackslashpm0.35{\textbackslash} Gyr and {\textbackslash}1.95{\textbackslash}textbackslashpm0.40{\textbackslash} Gyr, respectively. Photometric distances were calculated to be {\textbackslash}2850{\textbackslash}textbackslashpm 185{\textbackslash} pc for KIC 5113146 and {\textbackslash}3120{\textbackslash}textbackslashpm 260{\textbackslash} pc for KIC 5111815. The results obtained in this study, astrometric data and researches in the literature reveal that both KIC 5113146 and KIC 5111815 systems are the most likely member of NGC 6819.},
	urldate = {2020-09-15},
	journal = {arXiv:2009.05610 [astro-ph]},
	author = {Soydugan, E. and Alicavus, F. and Soydugan, F. and Bilir, S.},
	month = sep,
	year = {2020},
	keywords = {Astrophysics - Solar and Stellar Astrophysics, Astrophysics - Astrophysics of Galaxies},
	annote = {arXiv: 2009.05610},
}

@article{greaves_phosphine_2020,
	title = {Phosphine {Gas} in the {Cloud} {Decks} of {Venus}},
	url = {http://arxiv.org/abs/2009.06593},
	abstract = {Measurements of trace-gases in planetary atmospheres help us explore chemical conditions different to those on Earth. Our nearest neighbor, Venus, has cloud decks that are temperate but hyper-acidic. We report the apparent presence of phosphine (PH3) gas in Venusian atmosphere, where any phosphorus should be in oxidized forms. Single-line millimeter-waveband spectral detections (quality up to {\textbackslash}textasciitilde15 sigma) from the JCMT and ALMA telescopes have no other plausible identification. Atmospheric PH3 at {\textbackslash}textasciitilde20 parts-per-billion abundance is inferred. The presence of phosphine is unexplained after exhaustive study of steady-state chemistry and photochemical pathways, with no currently-known abiotic production routes in Venusian atmosphere, clouds, surface and subsurface, or from lightning, volcanic or meteoritic delivery. Phosphine could originate from unknown photochemistry or geochemistry, or, by analogy with biological production of phosphine on Earth, from the presence of life. Other PH3 spectral features should be sought, while in-situ cloud and surface sampling could examine sources of this gas.},
	urldate = {2020-09-15},
	journal = {arXiv:2009.06593 [astro-ph]},
	author = {Greaves, Jane S. and Richards, Anita M. S. and Bains, William and Rimmer, Paul B. and Sagawa, Hideo and Clements, David L. and Seager, Sara and Petkowski, Janusz J. and Sousa-Silva, Clara and Ranjan, Sukrit and Drabek-Maunder, Emily and Fraser, Helen J. and Cartwright, Annabel and Mueller-Wodarg, Ingo and Zhan, Zhuchang and Friberg, Per and Coulson, Iain and Lee, E'lisa and Hoge, Jim},
	month = sep,
	year = {2020},
	keywords = {Astrophysics - Earth and Planetary Astrophysics},
	annote = {arXiv: 2009.06593},
}

@article{stassun_discovery_2006,
	title = {Discovery of two young brown dwarfs in an eclipsing binary system},
	volume = {440},
	copyright = {2006 Nature Publishing Group},
	issn = {1476-4687},
	url = {https://www.nature.com/articles/nature04570},
	doi = {10.1038/nature04570},
	abstract = {Brown dwarfs are so-called failed stars that have insufficient mass to sustain nuclear reactions but are too massive to be planets. From this in-between position, brown dwarfs offer unique insights into the nature and origins of both stars and planets. Until now it has not been possible to measure the fundamental physical properties of brown dwarfs directly. But with the discovery of two young brown dwarfs in an eclipsing binary system in the Orion Nebula star-forming region, it has been possible to measure the mass and radius of two in one go. Surprisingly, the less-massive brown dwarf is the hotter of the pair; a finding that runs contrary to the predictions of all current theoretical models of coeval brown dwarfs. This might mean that the two brown dwarfs did not form at the same time, but got together in the recent past.},
	language = {en},
	number = {7082},
	urldate = {2020-09-11},
	journal = {Nature},
	publisher = {Nature Publishing Group},
	author = {Stassun, Keivan G. and Mathieu, Robert D. and Valenti, Jeff A.},
	month = mar,
	year = {2006},
	pages = {311--314},
	annote = {Number: 7082},
}

@article{david_new_2016,
